<% layout("/layouts/boilerplate") %>

<body>
    <div class="row">
        <h2 class="col-6 offset-3">Signup on Wonderlust</h2>
        <div class="col-6 offset-3">

         <form action="/signup"  novalidate class="needs-validation" method="post">
            <div class="mb-3" >
               <label for="username" class="form-label">Username:</label>
               <input type="text" name="username" placeholder="enter username"  class="form-control" id="username" required>
               
               <div class="valid-feedback">Name looks good!</div>
            </div>
            <div class="mb-3" >
               <label for="email" class="form-label">email:</label>
               <input type="email" name="email" placeholder="enter email"  class="form-control" id="email" required>
               
               
            </div>
            <div class="mb-3" >
               <label for="password" class="form-label">password:</label>
               <input type="password" name="password" placeholder="enter password"  class="form-control" id="password" required>
               
               
            </div>

            <button class="btn btn-success">Signup</button>
        </form>
        </div>
    </div>
</body>