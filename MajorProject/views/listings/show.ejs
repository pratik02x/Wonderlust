
<% layout("/layouts/boilerplate") %>
<body>
    

    <div class="row">
        <div class="col-8 offset-3" >
          <h2 class="mt-3"><%=list.title%></h2>
        </div>
      <div class="card col-6 offset-3 listing-card">
        <img src="<%= list.image %>" class="card-img-top show-img" alt="listing_img">
       <div class="card-body">
          
           <p class="card-text">
           
            <%=list.description%> <br>
            &#8377 <%=list.price.toLocaleString("en-IN")%> <br>
            <%=list.location%> <br>
            <%=list.country%>
        
           </p>
    
        </div>
     </div>

     
     <div class="btns col-8 offset-3">
        
    <form action="/listings/<%=list._id%>/edit" method="get">
        <button class="btn btn-dark offset-3 add-btn">Edit</button>
    </form>

    <form action="/listings/<%=list._id%>?_method=delete" method="post">
        <button class="btn btn-dark offset-6 delete-btn">Delete</button>
    </form>
    </div>
   
    

    <div class="col-8 offset-3 mb-3 " >
         <hr>
     
        <h4>Leave a Review</h4>
        <form action="/listings/<%=list._id%>/reviews" method="post" novalidate class="needs-validation">
        <div class="mt-3 mb-3">
            <label for="rating" class="form-label">Rating</label>
            <input type="range" min="1" max="5" name="rating"  class="form-range" required>
        </div>
        <div class="mt-3 mb-3">
            <label for="comment" class="form-label">Comments</label>
            <textarea name="comment" id="comment" cols="30" rows="5" class="form-control" required></textarea>
            <div class="invalid-feedback">please enter a feedback</div>
        </div>
        
        <button class="btn btn-outline-dark">Submit</button>
        </form>
    </div>


     <div class="col-8 offset-3 mb-3">
        <hr>
    
      <p><b>All Reviews</b></p>

      <div class="row">
      
          <% for(let review of list.reviews) { %>
             <div class="card col-5 mb-3 ms-3">
                <div class="card-body">
                     <h5 class="card-title">Pratik</h5>
                     <p class="card-text"><%= review.comment %></p>
                     <p class="card-text"><%= review.rating %> stars</p>

                </div>
               <form action="/listings/<%= list.id %>/reviews/<%= review._id %>?_method=delete" method="post">
                    <button class="btn btn-sm  mb-3 btn-dark ">Delete</button>
               </form>
                
                
             </div>
                     
            <% } %>
        
      </div>   
    </div>
    </div>
    
</body>
