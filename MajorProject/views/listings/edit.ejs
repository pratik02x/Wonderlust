<% layout("/layouts/boilerplate") %>
<body>
    <div class="row">

    <form action="/listings/<%=list._id%>/edit?_method=PUT" method="post" novalidate class="needs-validation">
      <div class="col col-8 offset-2 mt-3">
        <h3>Edit list</h3>
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" name="title" placeholder="title" value="<%=list.title%>" id="title" class="form-control"  required>
            <div class="invalid-feedback">Title required</div>
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="description" placeholder="enter desciption" value="" id="description" class="form-control" required><%=list.description%></textarea>
            <div class="invalid-feedback">description should be required</div>
        </div>
    
        <div class="mb-3">
            <label for="img" class="form-label">Image URL/Link</label>
            <input type="text" name="img" placeholder="enter URL/link" value="<%=list.image%>" class="form-control" id="img" required>
             <div class="invalid-feedback">Image link or URL required</div>
        </div>
        
        <div class="row">


        
        <div class="mb-3 col-4">
            <label for="price" class="form-label">Price</label>
            <input type="text" name="price" placeholder="enter price" value="<%=list.price%>" class="form-control" id="price" required >
             <div class="invalid-feedback">price should be required</div>
        </div>
        
        <div class="mb-3 col-8">
            <label for="location" class="form-label">Location</label>
            <input type="text" name="location" placeholder="enter location" value="<%=list.location%>" class="form-control" id="location" required>
             <div class="invalid-feedback">location should be required</div>
        </div>
        </div>  
        <div class="mb-3">
            <label for="country" class="form-label">Country</label>
           <input type="text" name="country" placeholder="enter country" value="<%=list.country%>" id="country" class="form-control" required>
            <div class="invalid-feedback">country should be required</div>
        </div>

        <button class="btn add-btn mt-3">Update</button>
        </div>
    </form>
    </div>

    
</body>
